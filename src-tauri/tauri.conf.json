{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Companion",
  "version": "0.11.8",
  "identifier": "com.shiroenguyen.desktop-companion",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http://petmodel.localhost petmodel:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://petmodel.localhost petmodel:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OEE1RDZENTkzNUUzOEMKUldTTTR6VlpiVjJLS1JmRWVFa3lGWEF5UC9IM2hZcmo1dXJQRkd0MGxFdVBRMUpDclpIemxFaU8K",
      "endpoints": [
        "https://github.com/xShiroeNguyenx/desktop-companion/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "publisher": "Desktop Companion",
    "category": "Productivity",
    "shortDescription": "Live2D desktop pet with AI translate / reply / tasks",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
